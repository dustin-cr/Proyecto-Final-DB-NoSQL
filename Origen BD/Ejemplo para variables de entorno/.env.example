# =====================================================================
# Plantilla de variables de entorno.
# Instrucciones
# 1. Copiar este archivo y renómbrarlo a ".env" (sin "example").
# 2. Reemplazar CAMBIAR por la contraseña  de cada usuario.
# 3. El archivo .env NUNCA se sube a GitHub ni se comparte por chat
#    (ya se incluyo en .gitignore).
#
# Si una contraseña tiene caracteres especiales (@ : / ? # [ ] %),
# escríbalos codificados: @ = %40, : = %3A, / = %2F, # = %23, % = %25
# =====================================================================

# Usado por la API en Node.js (rol: rolApi)
MONGO_URI_API=mongodb://api_resenas:CAMBIAR@127.0.0.1:27017/resenas_nlp?authSource=resenas_nlp

# Usado por los scripts de Python: carga y análisis NLP (rol: rolNlp)
MONGO_URI_NLP=mongodb://nlp_resenas:CAMBIAR@127.0.0.1:27017/resenas_nlp?authSource=resenas_nlp

# Solo lectura, para consultas en Compass y demostraciones (rol: rolLectura)
MONGO_URI_LECTURA=mongodb://lector_resenas:CAMBIAR@127.0.0.1:27017/resenas_nlp?authSource=resenas_nlp

MONGO_DB=resenas_nlp
