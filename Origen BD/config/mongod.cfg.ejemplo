# =====================================================================
# Configuración de seguridad para MongoDB local (Windows)
#
# ir a  C:\Program Files\MongoDB\Server\<versión>\bin\mongod.cfg
# abrir el archivo .cfg desde blog de notas como administrador y 
# HAcer los cambios mostrados abajo
# # =====================================================================

# Solo acepta conexiones desde esta misma computadora.
net:
  port: 27017
  bindIp: 127.0.0.1

# Exige usuario y contraseña para cualquier operación.
security:
  authorization: enabled
